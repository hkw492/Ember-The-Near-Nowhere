# Standard Unreal Engine .gitignore

# Compiled source files for the engine to use
Intermediate/
Build/
DerivedDataCache/

# Configuration files generated by the Editor
Saved/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Executables
*.exe
*.out
*.app

# Visual Studio user specific files
.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Binary Files (Only ignore if you compile code yourself)
Binaries/
Plugins/*/Binaries/

# XCode (Mac)
*.xcodeproj
*.xcworkspace